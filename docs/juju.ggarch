        relation_uuid [label: "relation_uuid", type: "text", fk: true]
        unit_name [label: "unit_name", type: "text"]
        value [label: "value", type: "text", null: true]
      }
    }

    relation_unit_settings_hash [type: record, label: "relation_unit_settings_hash",
                 ground: "model:relation_unit_settings_hash"] {
      fields {
