// The Juju model for the documentation.
//
// One model serves every page: nodes and edges are declared once and the
// views (diagrams and sequences) select what each page needs. Pages embed
// a view with the {ggarch} directive:
//
//   ```{ggarch}
//   :file: ../juju.ggarch
//   :view: The insight
//   ```
//
// Colour means ownership (orange = Juju, grey = outside Juju); a cloud
// badge marks an entity as deployed on a node from a cloud. See the
// ggarch SKILL.md "Visual grammar".

model "Juju" {

  nodes {
    // Actors and systems around Juju.
    // Before Juju enters the story the person is an SRE; from "The insight"
    // on, the same person is a Juju user (the account the controller knows).
    sre      [type: person,        label: "SRE"]
    user     [type: person,        label: "User"]
    client   [type: juju-software, label: "Client"]
    charmhub [type: external,      label: "Charmhub"]
    cloud    [type: external,      label: "Cloud"]
    clouds   [type: external,      label: "Clouds\n(AWS, MAAS, OpenStack,\nKubernetes, …)",
              collective: cloud]

    controller [type: juju-software, label: "Controller"]

    ssh_controller [type: juju-software, label: "Controller",
                    abstracts: "controller"] {
      ssh_gateway [type: juju-software,
                   label: "SSH tunnel server\n(port 17022)"]
      ssh_session [type: juju-software, label: "Target SSH server\n(virtual host key)"]
      ssh_api     [type: juju-software, label: "API server\n(port 17070)"]
      ssh_db      [type: database, label: "Model database\n(tunnel request)"]
    }
    ssh_target [type: external, label: "Machine or unit"]
    ssh_processing_controller [type: juju-software, label: "Controller",
                               abstracts: "controller"] {
      ssh_decrypt [label: "🔓 decrypt"]
      ssh_proxy   [type: juju-software, label: "SSH Proxy\n(inspect/process)"]
      ssh_encrypt [label: "🔒 encrypt"]
    }
    ssh_machine [type: node, label: "Machine", deployed: true] {
      ssh_machine_agent [type: juju-software, label: "Machine agent"]
      ssh_machine_server [type: external, label: "Machine SSH server"]
    }
    ssh_k8s_api [type: external, label: "Kubernetes API server"]
    ssh_pod     [type: node, label: "Unit pod", deployed: true] {
      ssh_container [type: workload, label: "Target container"]
    }

    // "The insight" shows Juju as one piece between the user and the
    // applications. "The topology" opens it into a client and a controller
    // and brings in the clouds and Charmhub.
    juju     [type: juju-software, label: "Juju"]

    // The entity chain: a model holds applications and an application runs
    // as units. Models and applications are logical entities (dotted). A
    // model lives on a cloud (the cloud badge), because that is where its
    // workers get nodes from. A unit is a node with the unit agent, the
    // charm and the workload on it.
    model [type: entity, label: "Model", deployed: true] {
      application [type: entity, label: "Application"] {
        unit_node [type: node, label: "Unit"] {
          unit_agent [type: juju-software, label: "Unit agent"]
          charm      [type: charm,         label: "Charm"]
          workload   [type: workload,      label: "Workload"]
        }
      }
    }

    // The applications as the user sees them: on nodes from a cloud,
    // outside Juju. "The problem" and "The insight" draw them.
    bare_node [type: external, label: "Node"]
    bare_applications [type: external, label: "Applications", deployed: true,
                       collective: bare_node]

    // High availability on machine clouds: every controller machine runs the
    // API server, the dbaccessor worker and one Dqlite node. The views stamp
    // the machine as many times as the controller has machines.
    ha_machine [type: node, label: "Controller machine", deployed: true] {
      ha_api      [type: juju-software, label: "API server"]
      ha_dbworker [type: juju-software, label: "dbaccessor worker"]
      ha_dqlite   [type: database, label: "Dqlite node\n(controller and model\ndatabases)"]
    }
    ha_callers [type: juju-software, label: "Clients and agents"]

    // Relation kinds. A relation joins two application endpoints; a peer
    // relation joins an application to itself, a subordinate relation joins a
    // subordinate to its principal, a cross-model relation reaches an
    // application in another model.
    rel_model [type: entity, label: "Model"] {
      rel_a         [type: entity, label: "Application A"]
      rel_peer      [type: entity, label: "Application D"] {
        rel_peer_0  [type: unit, label: "D/0"]
        rel_peer_1  [type: unit, label: "D/1"]
      }
      rel_b         [type: entity, label: "Application B"]
      rel_principal [type: entity, label: "Principal\napplication"]
      rel_sub       [type: entity, label: "Subordinate\napplication"]
    }
    rel_other_model [type: entity, label: "Other model"] {
      rel_remote [type: entity, label: "Application C"]
    }

    // Relation databags as one unit sees them.
    db_local [type: entity, label: "Local application"] {
      db_app_bag [type: record, label: "Local application\ndatabag"]
      db_leader  [type: unit, label: "Leader unit"]
      db_leader_bag [type: record, label: "Leader's unit\ndatabag"]
      db_other   [type: unit, label: "Other unit"]
      db_other_bag [type: record, label: "Other unit's\ndatabag"]
    }
    db_remote [type: entity, label: "Remote application"] {
      db_remote_app_bag [type: record, label: "Remote application\ndatabag"]
      db_remote_unit [type: unit, label: "Remote unit"]
      db_remote_bag [type: record, label: "Remote unit\ndatabag"]
    }

    // Two unit agents, for integration.
    agent_foo [type: juju-software, label: "Unit agent\n(foo/0)"]
    agent_bar [type: juju-software, label: "Unit agent\n(bar/0)"]

    // The tutorial's chat service: three applications that do not form a
    // whole. Each is an abstraction with the Juju mark: a unit agent and a
    // charm run behind it.
    mattermost [type: charmed-entity, label: "Mattermost"]
    postgresql [type: charmed-entity, label: "PostgreSQL"]
    certs      [type: charmed-entity, label: "Certs"]
  }

  edges {
    // The problem
    sre  -> bare_applications [type: control, label: "operates"]

    // The insight
    user         -> juju              [type: api,     label: "declares intent to"]
    juju         -> bare_applications [type: control, label: "operates"]

    // The topology: declare a goal state, persist it, reconcile with it
    user         -> client       [type: api,    label: "declares goal state to"]
    client       -> controller   [type: api,    label: "persists goal state in"]
    controller   -> clouds       [type: api,    label: "gets nodes from"]
    controller   -> charmhub     [type: api,    label: "gets charms from"]

    // The topology
    unit_agent -> controller [type: stream,  label: "reconciles state with"]
    unit_agent -> charm      [type: control, label: "runs"]
    charm      -> workload   [type: control, label: "operates"]

    // The steps
    client     -> client     [type: api,    label: "saves to"]
    client     -> cloud      [type: api,    label: "gets a node from"]
    controller -> cloud      [type: api,    label: "gets nodes from"]
    agent_foo  -> controller [type: stream, label: "watches"]
    agent_bar  -> controller [type: stream, label: "watches"]

    // The tutorial: the unit agents of the chat applications watch the
    // controller, as every unit agent does.
    mattermost -> controller [type: stream, label: "unit agents watch"]
    postgresql -> controller [type: stream, label: "unit agents watch"]
    certs      -> controller [type: stream, label: "unit agents watch"]

    // High availability
    ha_callers  -> ha_api      [type: api,     label: "connect to any"]
    ha_api      -> ha_dbworker [type: ipc,     label: "gets databases from"]
    ha_dbworker -> ha_dqlite   [type: control, label: "runs and clusters"]
    ha_dqlite   -> ha_dqlite   [type: stream,  label: "Raft", pairing: mesh]

    // Relation kinds
    rel_a         -> rel_b         [type: association, label: "regular"]
    rel_peer_0    -> rel_peer_1    [type: association, label: "peer"]
    rel_sub       -> rel_principal [type: association, label: "subordinate"]
    rel_remote    -> rel_b         [type: association, label: "cross-model"]

    // Relation databags
    db_leader -> db_app_bag        [type: writes, label: "reads and writes"]
    db_leader -> db_leader_bag     [type: writes, label: "reads and writes"]
    db_other  -> db_other_bag      [type: writes, label: "reads and writes"]
    db_other  -> db_app_bag        [type: reads,  label: "reads"]
    db_leader -> db_other_bag      [type: reads,  label: "reads"]
    db_other  -> db_leader_bag     [type: reads,  label: "reads"]
    db_leader -> db_remote_app_bag [type: reads,  label: "reads"]
    db_other  -> db_remote_app_bag [type: reads,  label: "reads"]
    db_leader -> db_remote_bag     [type: reads,  label: "reads"]
    db_other  -> db_remote_bag     [type: reads,  label: "reads"]
    db_remote_unit -> db_remote_bag [type: writes, label: "reads and writes"]

    client -> ssh_gateway [type: stream, label: "outer SSH tunnel"]
    client -> ssh_session [type: stream, label: "inner SSH session"]
    client -> ssh_api [type: api, label: "fetches expected host keys"]
    ssh_gateway -> ssh_session [type: ipc, label: "forwards inner SSH"]
    ssh_session -> ssh_target [type: stream, label: "proxies session"]
    ssh_controller -> ssh_k8s_api [type: stream, label: "exec stream"]
    ssh_k8s_api -> ssh_container [type: stream, label: "executes in"]
    ssh_session -> ssh_db [type: api, label: "1. stores tunnel request"]
    ssh_machine_agent -> ssh_db [type: stream, label: "2. observes request via API"]
    ssh_machine_agent -> ssh_api [type: stream, label: "3. opens reverse tunnel"]
    ssh_session -> ssh_machine_server [type: stream, label: "4. SSH over reverse tunnel"]
    client -> ssh_processing_controller [type: stream]
    ssh_processing_controller -> ssh_target [type: stream]
    ssh_decrypt -> ssh_proxy [type: control]
    ssh_proxy -> ssh_encrypt [type: control]
  }

  behaviours {
    behaviour "add-cloud" {
      user   -> client: call "juju add-cloud"
      client -> client: self "save the cloud definition"
      client -> user:   return "cloud added"
    }
    behaviour "add-credential" {
      user   -> client: call "juju add-credential"
      client -> client: self "save the credential"
      client -> user:   return "credential added"
    }
    behaviour "bootstrap" {
      user       -> client:     call "juju bootstrap"
      client     -> cloud:      call "get a node"
      cloud      -> client:     return "node ready"
      client     -> controller: call "install and start the controller"
      controller -> controller: self "initialize the database"
      controller -> client:     return "API ready"
    }
    // Kubernetes clouds: one command adds the cluster and its credential from
    // the kubeconfig, and the cluster runs the controller and the application
    // pods, so there is no node to get and nothing to install by hand.
    behaviour "add-k8s" {
      user   -> client: call "juju add-k8s"
      client -> client: self "save the cloud and its credential"
      client -> user:   return "cloud added"
    }
    behaviour "bootstrap-k8s" {
      user       -> client:     call "juju bootstrap"
      client     -> cloud:      call "create the controller StatefulSet"
      cloud      -> client:     return "created"
      client     -> controller: call "wait for the API"
      controller -> controller: self "initialize the database"
      controller -> client:     return "API ready"
    }
    behaviour "add-model" {
      user       -> client:     call "juju add-model"
      client     -> controller: call "declare the model"
      controller -> controller: self "persist it in the database"
      controller -> client:     return "model ready"
    }
    behaviour "deploy" {
      user       -> client:     call "juju deploy foo"
      client     -> controller: call "declare the application"
      controller -> controller: self "persist it in the database"
      controller -> charmhub:   call "get the charm"
      controller -> cloud:      call "get a node"
      cloud      -> controller: return "node ready"
      controller -> unit_agent: async "watcher fires"
      unit_agent -> controller: call "fetch the current state"
      unit_agent -> charm:      call "run the install hook"
      unit_agent -> controller: call "report the result"
    }
    behaviour "deploy-k8s" {
      user       -> client:     call "juju deploy foo"
      client     -> controller: call "declare the application"
      controller -> controller: self "persist it in the database"
      controller -> charmhub:   call "get the charm"
      controller -> cloud:      call "create the application's pods"
      cloud      -> controller: return "pods created"
      controller -> unit_agent: async "watcher fires"
      unit_agent -> controller: call "fetch the current state"
      unit_agent -> charm:      call "run the install hook"
      unit_agent -> controller: call "report the result"
    }
    behaviour "config" {
      user       -> client:     call "juju config foo key=value"
      client     -> controller: call "declare the new value"
      controller -> controller: self "persist it in the database"
      controller -> unit_agent: async "watcher fires"
      unit_agent -> controller: call "fetch the current state"
      unit_agent -> charm:      call "run the config-changed hook"
      unit_agent -> controller: call "report the result"
    }
    behaviour "integrate" {
      user       -> client:     call "juju integrate foo bar"
      client     -> controller: call "declare the integration"
      controller -> controller: self "persist it in the database"
      controller -> agent_foo:  async "watcher fires"
      controller -> agent_bar:  async "watcher fires"
      agent_foo  -> controller: call "fetch state, run relation hooks"
      agent_bar  -> controller: call "fetch state, run relation hooks"
    }
  }

  style {
    extends: juju
    edge association { arrowhead: none }
    edge writes { stroke-width: 2 }
    edge reads { stroke-dash: "3,3" }
  }
}

// The data model: the tables behind the reference pages, scaffolded from the
// 4.1 DDL by experiments/e45/build_schema.py (`ggarch scaffold model.ddl --db
// model --tables ...`). The scaffold drops quoted column names, so each "key"
// column is added by hand.
model "Schema" {

  nodes {
    application [type: record, label: "application",
                 ground: "model:application"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
        life_id [label: "life_id", type: "int", fk: true]
        charm_uuid [label: "charm_uuid", type: "text", fk: true]
        charm_modified_version [label: "charm_modified_version", type: "int"]
        charm_upgrade_on_error [label: "charm_upgrade_on_error", type: "bool", null: true]
        space_uuid [label: "space_uuid", type: "text", fk: true]
      }
    }

    application_endpoint [type: record, label: "application_endpoint",
                 ground: "model:application_endpoint"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        application_uuid [label: "application_uuid", type: "text", fk: true]
        space_uuid [label: "space_uuid", type: "text", fk: true, null: true]
        charm_relation_uuid [label: "charm_relation_uuid", type: "text", fk: true]
      }
    }

    architecture [type: record, label: "architecture",
                 ground: "model:architecture"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        name [label: "name", type: "text"]
      }
    }

    charm [type: record, label: "charm",
                 ground: "model:charm"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        archive_path [label: "archive_path", type: "text", null: true]
        object_store_uuid [label: "object_store_uuid", type: "text", fk: true, null: true]
        available [label: "available", type: "bool", null: true]
        version [label: "version", type: "text", null: true]
        lxd_profile [label: "lxd_profile", type: "text", null: true]
        source_id [label: "source_id", type: "int", fk: true]
        revision [label: "revision", type: "int"]
        architecture_id [label: "architecture_id", type: "int", fk: true, null: true]
        reference_name [label: "reference_name", type: "text"]
        create_time [label: "create_time", type: "datetime"]
      }
    }

    charm_relation [type: record, label: "charm_relation",
                 ground: "model:charm_relation"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        charm_uuid [label: "charm_uuid", type: "text", fk: true]
        name [label: "name", type: "text"]
        role_id [label: "role_id", type: "int", fk: true]
        scope_id [label: "scope_id", type: "int", fk: true]
        interface [label: "interface", type: "text", null: true]
        optional [label: "optional", type: "bool", null: true]
        capacity [label: "capacity", type: "int", null: true]
      }
    }

    charm_relation_role [type: record, label: "charm_relation_role",
                 ground: "model:charm_relation_role"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        name [label: "name", type: "text"]
      }
    }

    charm_relation_scope [type: record, label: "charm_relation_scope",
                 ground: "model:charm_relation_scope"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        name [label: "name", type: "text"]
      }
    }

    charm_source [type: record, label: "charm_source",
                 ground: "model:charm_source"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        name [label: "name", type: "text"]
      }
    }

    life [type: record, label: "life",
                 ground: "model:life"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        value [label: "value", type: "text"]
      }
    }

    machine [type: record, label: "machine",
                 ground: "model:machine"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
        net_node_uuid [label: "net_node_uuid", type: "text", fk: true]
        life_id [label: "life_id", type: "int", fk: true]
        nonce [label: "nonce", type: "text", null: true]
        password_hash_algorithm_id [label: "password_hash_algorithm_id", type: "text", fk: true, null: true]
        password_hash [label: "password_hash", type: "text", null: true]
        force_destroyed [label: "force_destroyed", type: "bool", null: true]
        agent_started_at [label: "agent_started_at", type: "datetime", null: true]
        hostname [label: "hostname", type: "text", null: true]
        keep_instance [label: "keep_instance", type: "bool", null: true]
      }
    }

    model [type: record, label: "model",
                 ground: "model:model"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        controller_uuid [label: "controller_uuid", type: "text"]
        name [label: "name", type: "text"]
        qualifier [label: "qualifier", type: "text"]
        type [label: "type", type: "text"]
        cloud [label: "cloud", type: "text"]
        cloud_type [label: "cloud_type", type: "text"]
        cloud_region [label: "cloud_region", type: "text", null: true]
        credential_owner [label: "credential_owner", type: "text", null: true]
        credential_name [label: "credential_name", type: "text", null: true]
        is_controller_model [label: "is_controller_model", type: "bool", null: true]
      }
    }

    model_agent [type: record, label: "model_agent",
                 ground: "model:model_agent"] {
      fields {
        model_uuid [label: "model_uuid", type: "text", fk: true]
        password_hash_algorithm_id [label: "password_hash_algorithm_id", type: "int", fk: true, null: true]
        password_hash [label: "password_hash", type: "text", null: true]
      }
    }

    model_constraint [type: record, label: "model_constraint",
                 ground: "model:model_constraint"] {
      fields {
        model_uuid [label: "model_uuid", type: "text", pk: true, fk: true]
        constraint_uuid [label: "constraint_uuid", type: "text"]
      }
    }

    model_life [type: record, label: "model_life",
                 ground: "model:model_life"] {
      fields {
        model_uuid [label: "model_uuid", type: "text", pk: true, fk: true]
        life_id [label: "life_id", type: "text", fk: true]
      }
    }

    net_node [type: record, label: "net_node",
                 ground: "model:net_node"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
      }
    }

    object_store_metadata [type: record, label: "object_store_metadata",
                 ground: "model:object_store_metadata"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        sha_256 [label: "sha_256", type: "text"]
        sha_384 [label: "sha_384", type: "text"]
        size [label: "size", type: "int"]
      }
    }

    object_store_metadata_path [type: record, label: "object_store_metadata_path",
                 ground: "model:object_store_metadata_path"] {
      fields {
        path [label: "path", type: "text", pk: true]
        metadata_uuid [label: "metadata_uuid", type: "text", fk: true]
      }
    }

    operation [type: record, label: "operation",
                 ground: "model:operation"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        operation_id [label: "operation_id", type: "int"]
        summary [label: "summary", type: "text", null: true]
        enqueued_at [label: "enqueued_at", type: "timestamp"]
        started_at [label: "started_at", type: "timestamp", null: true]
        completed_at [label: "completed_at", type: "timestamp", null: true]
        parallel [label: "parallel", type: "bool", null: true]
        execution_group [label: "execution_group", type: "text", null: true]
      }
    }

    operation_action [type: record, label: "operation_action",
                 ground: "model:operation_action"] {
      fields {
        operation_uuid [label: "operation_uuid", type: "text", pk: true, fk: true]
        charm_uuid [label: "charm_uuid", type: "text"]
        charm_action_key [label: "charm_action_key", type: "text"]
      }
    }

    operation_machine_task [type: record, label: "operation_machine_task",
                 ground: "model:operation_machine_task"] {
      fields {
        task_uuid [label: "task_uuid", type: "text", fk: true]
        machine_uuid [label: "machine_uuid", type: "text", fk: true]
      }
    }

    operation_parameter [type: record, label: "operation_parameter",
                 ground: "model:operation_parameter"] {
      fields {
        key [label: "key", type: "text", pk: true]
        operation_uuid [label: "operation_uuid", type: "text", fk: true]
        value [label: "value", type: "text"]
      }
    }

    operation_task [type: record, label: "operation_task",
                 ground: "model:operation_task"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        operation_uuid [label: "operation_uuid", type: "text", fk: true]
        task_id [label: "task_id", type: "text"]
        enqueued_at [label: "enqueued_at", type: "datetime"]
        started_at [label: "started_at", type: "datetime", null: true]
        completed_at [label: "completed_at", type: "datetime", null: true]
      }
    }

    operation_task_log [type: record, label: "operation_task_log",
                 ground: "model:operation_task_log"] {
      fields {
        task_uuid [label: "task_uuid", type: "text", fk: true]
        content [label: "content", type: "text"]
        created_at [label: "created_at", type: "timestamp"]
      }
    }

    operation_task_output [type: record, label: "operation_task_output",
                 ground: "model:operation_task_output"] {
      fields {
        task_uuid [label: "task_uuid", type: "text", pk: true, fk: true]
        store_path [label: "store_path", type: "text", fk: true]
      }
    }

    operation_task_status [type: record, label: "operation_task_status",
                 ground: "model:operation_task_status"] {
      fields {
        task_uuid [label: "task_uuid", type: "text", pk: true, fk: true]
        status_id [label: "status_id", type: "int", fk: true]
        message [label: "message", type: "text", null: true]
        updated_at [label: "updated_at", type: "datetime", null: true]
      }
    }

    operation_task_status_value [type: record, label: "operation_task_status_value",
                 ground: "model:operation_task_status_value"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        status [label: "status", type: "text"]
      }
    }

    operation_unit_task [type: record, label: "operation_unit_task",
                 ground: "model:operation_unit_task"] {
      fields {
