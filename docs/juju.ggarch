    charm.architecture_id -> architecture.id [type: data]
    charm.object_store_uuid -> object_store_metadata.uuid [type: data]
    charm_relation.charm_uuid -> charm.uuid [type: data]
    charm_relation.role_id -> charm_relation_role.id [type: data]
    charm_relation.scope_id -> charm_relation_scope.id [type: data]
    machine.net_node_uuid -> net_node.uuid [type: data]
    machine.life_id -> life.id [type: data]
    machine.password_hash_algorithm_id -> password_hash_algorithm.id [type: data]
    model_agent.model_uuid -> model.uuid [type: data]
    model_agent.password_hash_algorithm_id -> password_hash_algorithm.id [type: data]
    model_constraint.model_uuid -> model.uuid [type: data]
    model_life.model_uuid -> model.uuid [type: data]
    model_life.life_id -> life.id [type: data]
    object_store_metadata_path.metadata_uuid -> object_store_metadata.uuid [type: data]
    operation_action.operation_uuid -> operation.uuid [type: data]
    operation_machine_task.task_uuid -> operation_task.uuid [type: data]
    operation_machine_task.machine_uuid -> machine.uuid [type: data]
    operation_parameter.operation_uuid -> operation.uuid [type: data]
    operation_task.operation_uuid -> operation.uuid [type: data]
    operation_task_log.task_uuid -> operation_task.uuid [type: data]
    operation_task_output.task_uuid -> operation_task.uuid [type: data]
    operation_task_output.store_path -> object_store_metadata_path.path [type: data]
    operation_task_status.task_uuid -> operation_task.uuid [type: data]
    operation_task_status.status_id -> operation_task_status_value.id [type: data]
    operation_unit_task.task_uuid -> operation_task.uuid [type: data]
    operation_unit_task.unit_uuid -> unit.uuid [type: data]
    relation.life_id -> life.id [type: data]
    relation.scope_id -> charm_relation_scope.id [type: data]
    relation_application_setting.relation_endpoint_uuid -> relation_endpoint.uuid [type: data]
    relation_application_settings_hash.relation_endpoint_uuid -> relation_endpoint.uuid [type: data]
    relation_endpoint.relation_uuid -> relation.uuid [type: data]
    relation_endpoint.endpoint_uuid -> application_endpoint.uuid [type: data]
    relation_network_egress.relation_uuid -> relation.uuid [type: data]
    relation_network_ingress.relation_uuid -> relation.uuid [type: data]
    relation_status.relation_uuid -> relation.uuid [type: data]
    relation_status.relation_status_type_id -> relation_status_type.id [type: data]
    relation_unit.unit_uuid -> unit.uuid [type: data]
    relation_unit.relation_endpoint_uuid -> relation_endpoint.uuid [type: data]
    relation_unit_departure.relation_uuid -> relation.uuid [type: data]
    relation_unit_setting.relation_unit_uuid -> relation_unit.uuid [type: data]
    relation_unit_setting_archive.relation_uuid -> relation.uuid [type: data]
    relation_unit_settings_hash.relation_unit_uuid -> relation_unit.uuid [type: data]
    unit.life_id -> life.id [type: data]
    unit.application_uuid -> application.uuid [type: data]
    unit.net_node_uuid -> net_node.uuid [type: data]
    unit.charm_uuid -> charm.uuid [type: data]
    unit.password_hash_algorithm_id -> password_hash_algorithm.id [type: data]
  }

  style { extends: juju }

}

// The two state machines whose allowed changes the code enforces: the status
// of a relation (domain/status/status.go, RelationStatusTransitionValid) and
// the phase of a model migration (core/migration/phase.go, validTransitions).
model "Lifecycles" {

  nodes {
    rs_joining [label: "joining"]
    rs_joined [label: "joined"]
    rs_broken [label: "broken"]
    rs_suspending [label: "suspending"]
    rs_suspended [label: "suspended"]
    rs_error [label: "error"]
    mg_quiesce [label: "QUIESCE"]
    mg_import [label: "IMPORT"]
    mg_validation [label: "VALIDATION"]
    mg_success [label: "SUCCESS"]
    mg_logtransfer [label: "LOGTRANSFER"]
    mg_reap [label: "REAP"]
    mg_reapfailed [label: "REAPFAILED"]
    mg_done [label: "DONE"]
    mg_abort [label: "ABORT"]
    mg_abortdone [label: "ABORTDONE"]
  }

  edges {
    rs_joining -> rs_joined [type: control]
    rs_joining -> rs_suspending [type: control]
    rs_joining -> rs_suspended [type: control]
    rs_joined -> rs_suspending [type: control]
    rs_joined -> rs_suspended [type: control]
    rs_suspending -> rs_joining [type: control]
    rs_suspending -> rs_joined [type: control]
    rs_suspending -> rs_suspended [type: control]
    rs_suspended -> rs_joining [type: control]
    rs_suspended -> rs_joined [type: control]
    rs_joined -> rs_broken [type: control]
    rs_joined -> rs_error [type: control]
    rs_broken -> rs_error [type: control]
    rs_error -> rs_joined [type: control]
    mg_quiesce -> mg_import [type: control]
    mg_quiesce -> mg_abort [type: control]
    mg_import -> mg_validation [type: control]
    mg_import -> mg_abort [type: control]
    mg_validation -> mg_success [type: control]
    mg_validation -> mg_abort [type: control]
    mg_success -> mg_logtransfer [type: control]
    mg_logtransfer -> mg_reap [type: control]
    mg_reap -> mg_done [type: control]
    mg_reap -> mg_reapfailed [type: control]
    mg_abort -> mg_abortdone [type: control]
  }

  behaviours {
    behaviour "relation-status" {
      rs_joining -> rs_joined: call "set status"
      rs_joining -> rs_suspending: call "set status"
      rs_joining -> rs_suspended: call "set status"
      rs_joined -> rs_suspending: call "set status"
      rs_joined -> rs_suspended: call "set status"
      rs_suspending -> rs_joining: call "set status"
      rs_suspending -> rs_joined: call "set status"
      rs_suspending -> rs_suspended: call "set status"
      rs_suspended -> rs_joining: call "set status"
      rs_suspended -> rs_joined: call "set status"
      rs_joined -> rs_broken: call "set status" [guard: "from any state"]
      rs_joined -> rs_error: call "set status" [guard: "from any state; message required"]
      rs_broken -> rs_error: call "set status" [guard: "message required"]
      rs_error -> rs_joined: call "set status" [guard: "to any state"]
    }
    behaviour "migration-phase" {
      mg_quiesce -> mg_import: call "next phase"
      mg_import -> mg_validation: call "next phase"
      mg_validation -> mg_success: call "next phase"
      mg_success -> mg_logtransfer: call "next phase"
      mg_logtransfer -> mg_reap: call "next phase"
      mg_reap -> mg_done: call "next phase"
      mg_reap -> mg_reapfailed: call "next phase"
      mg_quiesce -> mg_abort: call "abort"
      mg_import -> mg_abort: call "abort"
      mg_validation -> mg_abort: call "abort"
      mg_abort -> mg_abortdone: call "next phase"
    }
  }

  style { extends: juju }
}

state "Relation status" from "Lifecycles" {
  select { behaviour: "relation-status" }
}

state "Model migration phase" from "Lifecycles" {
  select { behaviour: "migration-phase" }
}

diagram "The problem" from "Juju" {
  // The user and the applications, which run on nodes from clouds (the
  // cloud badge). The clouds themselves are a detail of "The topology".
  select {
    nodes: sre bare_applications
    edges: type control
    sizing: uniform
  }
  positions {
    sre               left-of bare_applications gap: 120
    sre               align-middle bare_applications
  }
}

diagram "The insight" from "Juju" {
  select {
    nodes: user juju bare_applications
    edges: type api type control
    sizing: uniform
  }
  positions {
    user              left-of juju gap: 100
    user              align-middle juju
    bare_applications right-of juju gap: 100
    bare_applications align-middle juju
  }
}

diagram "The topology" from "Juju" {
  select {
    nodes: user client controller clouds charmhub model
    edges: type api type stream type control
